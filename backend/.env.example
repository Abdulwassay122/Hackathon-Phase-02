# Database Configuration
# PostgreSQL connection string for Neon Serverless Database
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# JWT Authentication Secret
# MUST be at least 32 characters long for security
# Generate a secure random string for production
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long-for-security

# CORS Configuration
# REQUIRED for frontend-backend communication
# Set this to the URL where your frontend is running
#
# Format:
#   - Single origin: http://localhost:3000
#   - Multiple origins (comma-separated): http://localhost:3000,http://localhost:3001
#
# Examples:
#   Development: CORS_ORIGINS=http://localhost:3000
#   Staging: CORS_ORIGINS=https://staging.example.com,http://localhost:3000
#   Production: CORS_ORIGINS=https://app.example.com
#
# Security Notes:
#   - NEVER use wildcard (*) origins - this is a security vulnerability
#   - Always use explicit origin URLs (e.g., http://localhost:3000)
#   - Include protocol (http:// or https://)
#   - Do NOT include trailing slashes
#   - Use HTTPS in production environments
#
# If CORS_ORIGINS is not set, the backend will block all cross-origin requests
# and log a warning at startup.
CORS_ORIGINS=http://localhost:3000
